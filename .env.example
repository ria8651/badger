# Port the API/WebSocket server listens on (Vite dev server proxies to it)
PORT=3001
# Interface to bind. Keep 127.0.0.1 unless you put real auth in front of it.
HOST=127.0.0.1
# Default working directory offered for new chats
WORKSPACE_DIR=/path/to/your/repo
# Where Badger keeps its own database (cards). Defaults to ./data
DATA_DIR=
# Claude auth: either an API key, or leave unset to use the server's `claude` login
ANTHROPIC_API_KEY=
