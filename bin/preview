#!/usr/bin/env node
// Claude's way into the previews the user has open in Badger (server/bridge.ts).

import { mkdirSync, readFileSync, writeFileSync } from 'node:fs'
import { tmpdir } from 'node:os'
import { join, resolve } from 'node:path'

const HELP = `Look at and drive a page the user has open in a Badger preview: the real
page in their browser, with their login and whatever state it's in.

  preview                          List open preview pages, most recently used first
  preview <port> url               The page's URL and title
  preview <port> run <js>          Run JavaScript in the page and print the result
  preview <port> run               ...reading the code from stdin
  preview <port> logs [--clear]    Console output and errors since the page loaded
  preview <port> screenshot [selector] [--full] [-o file.png]
                                   Render the page (what's on screen, the whole page,
                                   or one element) to a PNG, and print its path
  preview <port> goto <url|path>   Navigate, and wait for the new page

Code runs as an async function: an expression gives its value, a body can
\`return\` one, and \`await\` works. Elements print as their tag and text, other
values as JSON. Helpers in scope:
  $(sel), $$(sel)          querySelector, querySelectorAll (as an array)
  click(sel|el)            a full pointer/mouse click; scrolls it into view first
  fill(sel|el, text)       replace a field's value, in a way React etc. notice
  press(key, sel?)         keydown/keyup; Enter in a form field submits it
  waitFor(sel|fn, ms?)     until it finds something (default 5000ms)
  text(sel?)               innerText of the element, or the whole page
  sleep(ms)

Screenshots are redrawn from the DOM, not captured, so canvas/WebGL, some CSS
and cross-origin images can come out wrong; check computed styles with run
when it matters.

Options: --timeout <seconds> (default 30). The page must be open in Badger's
preview panel or a browser tab; with several, the one the user was in last.`

const base = process.env.BADGER_URL || 'http://localhost:3001'

const args = process.argv.slice(2)
const flag = (name) => {
  const i = args.indexOf(name)
  return i >= 0 ? (args.splice(i, 1), true) : false
}
const option = (...names) => {
  const i = args.findIndex((a) => names.includes(a))
  return i >= 0 ? args.splice(i, 2)[1] : undefined
}

function fail(message) {
  process.stderr.write(message.endsWith('\n') ? message : message + '\n')
  process.exit(1)
}

async function api(path, body) {
  let res
  try {
    res = await fetch(base + path, body ? { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify(body) } : {})
  } catch (err) {
    fail(`Can't reach Badger at ${base}: ${err.cause?.message ?? err.message}`)
  }
  const data = await res.json().catch(() => ({}))
  if (!res.ok) fail(data.error ?? `${res.status} ${res.statusText}`)
  return data
}

if (flag('--help') || flag('-h') || args[0] === 'help') {
  console.log(HELP)
  process.exit(0)
}

const timeout = Number(option('--timeout') ?? 30)
const full = flag('--full')
const clear = flag('--clear')
const out = option('-o', '--output')
const [portArg, command = 'url', ...rest] = args

if (!portArg) {
  const pages = await api('/api/preview')
  if (!pages.length) fail('No preview pages are open. open_preview shows one in the user\'s browser.')
  for (const p of pages) console.log(`${p.port}  ${p.url}  ${JSON.stringify(p.title)}${p.visible ? '' : ' (hidden)'}  used ${p.idle}s ago`)
  process.exit(0)
}

const port = Number(portArg)
if (!Number.isInteger(port) || port < 1 || port > 65535) fail(`Not a port: ${portArg}\n\n${HELP}`)
const call = (request) => api(`/api/preview/${port}`, { ...request, timeout })

switch (command) {
  case 'url': {
    const { url, value: title } = await call({ op: 'run', code: 'document.title' })
    console.log(title ? `${url}\n${title}` : url)
    break
  }
  case 'run': {
    const code = rest.length ? rest.join(' ') : readFileSync(0, 'utf8')
    if (!code.trim()) fail('Nothing to run: pass the code as an argument or on stdin.')
    const { value } = await call({ op: 'run', code })
    console.log(value)
    break
  }
  case 'logs': {
    const { value } = await call({ op: 'logs' })
    if (!value.length) console.log('(no console output)')
    for (const l of value) console.log(`${new Date(l.at).toISOString().slice(11, 23)} ${l.level.padEnd(5)} ${l.text}`)
    if (clear) await call({ op: 'clear_logs' })
    break
  }
  case 'screenshot': {
    const { value } = await call({ op: 'screenshot', selector: rest.join(' ') || undefined, full })
    const file = out ? resolve(out) : join(tmpdir(), 'badger-preview', `${port}-${Date.now()}.png`)
    mkdirSync(join(file, '..'), { recursive: true })
    writeFileSync(file, Buffer.from(value.slice(value.indexOf(',') + 1), 'base64'))
    console.log(file)
    break
  }
  case 'goto': {
    if (!rest[0]) fail('Where to? e.g. preview 5173 goto /settings')
    const { url } = await call({ op: 'goto', url: rest[0] })
    console.log(url)
    break
  }
  default:
    fail(`Unknown command ${command}\n\n${HELP}`)
}
